---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { FaEnvelope, FaPhoneAlt } from "react-icons/fa";
import { FaWhatsapp } from "react-icons/fa6";

const { email, phone } = config.contactinfo;
---

<Base title="Contact" meta_title="Contact — The Orlando Guide">
  <section class="pt-12 pb-20">
    <div class="container max-w-xl mx-auto text-center">
      <h1 class="h2 mb-4">Get in Touch</h1>
      <p class="text-text mb-12">
        We're here to help you plan the perfect Orlando experience. Reach out through any of the channels below.
      </p>

      <ul class="flex flex-col gap-6 text-left">
        <li class="flex items-center gap-4 p-5 rounded-xl border border-border hover:border-primary transition">
          <FaWhatsapp className="text-primary text-3xl shrink-0" />
          <div>
            <p class="font-semibold text-dark">WhatsApp</p>
            <a href="https://wa.me/13214421907" target="_blank" class="text-text hover:text-primary transition">
              +1 (321) 442-1907
            </a>
          </div>
        </li>
        <li class="flex items-center gap-4 p-5 rounded-xl border border-border hover:border-primary transition">
          <FaEnvelope className="text-primary text-3xl shrink-0" />
          <div>
            <p class="font-semibold text-dark">Email</p>
            <a href={`mailto:${email}`} class="text-text hover:text-primary transition">
              {email}
            </a>
          </div>
        </li>
<li class="flex items-center gap-4 p-5 rounded-xl border border-border hover:border-primary transition">
          <FaPhoneAlt className="text-primary text-3xl shrink-0" />
          <div>
            <p class="font-semibold text-dark">Phone</p>
            <span class="text-text">{phone}</span>
          </div>
        </li>
      </ul>
    </div>
  </section>
</Base>

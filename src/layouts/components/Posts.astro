---
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
  fluid?: boolean;
};

const authors = await getSinglePage("authors");
const { className, posts } = Astro.props;

const featured = posts[0];
const sidebarPosts = posts.slice(1, 3);
const gridPosts = posts.slice(3);
---

<div class={className}>

  {/* ── Magazine hero: 1 featured (left) + 2 stacked (right) ── */}
  {featured && (
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-10">

      {/* Featured post */}
      <div class="lg:col-span-7">
        {featured.data.image && (
          <a href={`/blog/${featured.id}`} class="rounded-lg block overflow-hidden group mb-4">
            <Image
              class="group-hover:scale-[1.03] transition duration-300 w-full object-cover"
              src={featured.data.image}
              alt={featured.data.title}
              width={740}
              height={420}
            />
          </a>
        )}
        <span class="inline-block bg-primary text-white text-xs font-semibold px-3 py-1 rounded mb-3 uppercase tracking-wide">
          {humanize(featured.data.categories[0])}
        </span>
        <h2 class="mb-3">
          <a href={`/blog/${featured.id}`} class="hover:text-primary transition duration-300 leading-snug">
            {featured.data.title}
          </a>
        </h2>
        <p class="text-text line-clamp-2 mb-3">{plainify(featured.body ?? "")}</p>
        <span class="text-sm text-text-light flex items-center gap-1">
          <BiCalendarEdit className="h-4 w-4" />
          {dateFormat(featured.data.date!)}
        </span>
      </div>

      {/* Sidebar: 2 stacked posts */}
      {sidebarPosts.length > 0 && (
        <div class="lg:col-span-5 flex flex-col gap-6">
          {sidebarPosts.map((post) => (
            <div class="flex gap-4 items-start border-b border-border pb-6 last:border-0 last:pb-0">
              {post.data.image && (
                <a href={`/blog/${post.id}`} class="shrink-0 rounded overflow-hidden block group">
                  <Image
                    class="group-hover:scale-[1.03] transition duration-300 object-cover"
                    src={post.data.image}
                    alt={post.data.title}
                    width={160}
                    height={110}
                  />
                </a>
              )}
              <div class="min-w-0">
                <span class="text-xs font-semibold text-primary uppercase tracking-wide">
                  {humanize(post.data.categories[0])}
                </span>
                <h4 class="mt-1 mb-2 leading-snug">
                  <a href={`/blog/${post.id}`} class="hover:text-primary transition duration-300 line-clamp-2">
                    {post.data.title}
                  </a>
                </h4>
                <span class="text-xs text-text-light flex items-center gap-1">
                  <BiCalendarEdit className="h-3 w-3" />
                  {dateFormat(post.data.date!)}
                </span>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  )}

  {/* ── Grid row: remaining posts ── */}
  {gridPosts.length > 0 && (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {gridPosts.map((post) => (
        <div class="border border-border rounded-lg overflow-hidden hover:shadow-md transition duration-300">
          {post.data.image && (
            <a href={`/blog/${post.id}`} class="block overflow-hidden group">
              <Image
                class="group-hover:scale-[1.03] transition duration-300 w-full object-cover"
                src={post.data.image}
                alt={post.data.title}
                width={400}
                height={220}
              />
            </a>
          )}
          <div class="p-4">
            <span class="text-xs font-semibold text-primary uppercase tracking-wide">
              {humanize(post.data.categories[0])}
            </span>
            <h4 class="mt-2 mb-2 leading-snug">
              <a href={`/blog/${post.id}`} class="hover:text-primary transition duration-300 line-clamp-2">
                {post.data.title}
              </a>
            </h4>
            <p class="text-sm text-text line-clamp-2 mb-3">{plainify(post.body ?? "")}</p>
            <span class="text-xs text-text-light flex items-center gap-1">
              <BiCalendarEdit className="h-3 w-3" />
              {dateFormat(post.data.date!)}
            </span>
          </div>
        </div>
      ))}
    </div>
  )}

</div>

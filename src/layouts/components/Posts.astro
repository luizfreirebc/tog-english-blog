---
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
  fluid?: boolean;
};

const authors = await getSinglePage("authors");
const { className, posts } = Astro.props;

const featured = posts[0];
const sidebarPosts = posts.slice(1, 3);
const gridPosts = posts.slice(3);
---

<div class={className}>

  {/* ── HERO: featured post with image overlay ── */}
  {featured && (
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-10">

      {/* Featured — full image with gradient overlay */}
      <div class="lg:col-span-7 flex flex-col">
        <a href={`/blog/${featured.id}`} class="relative block rounded-xl overflow-hidden group flex-1 aspect-video lg:aspect-auto">
          {featured.data.image && (
            <Image
              class="w-full h-full object-cover group-hover:scale-[1.04] transition duration-500"
              src={featured.data.image}
              alt={featured.data.title}
              width={740}
              height={416}
            />
          )}
          {/* Dark gradient overlay */}
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          {/* Content on top */}
          <div class="absolute bottom-0 left-0 right-0 p-5">
            <span class="inline-block bg-primary text-white text-xs font-bold px-3 py-1 rounded-full mb-3 uppercase tracking-wider">
              {humanize(featured.data.categories[0])}
            </span>
            <h2 class="text-white leading-snug mb-2 drop-shadow">
              {featured.data.title}
            </h2>
            <span class="text-white/70 text-sm flex items-center gap-1">
              <BiCalendarEdit className="h-4 w-4" />
              {dateFormat(featured.data.date!)}
            </span>
          </div>
        </a>
      </div>

      {/* Sidebar: 2 stacked posts */}
      {sidebarPosts.length > 0 && (
        <div class="lg:col-span-5 flex flex-col gap-4">
          {sidebarPosts.map((post) => (
            <a href={`/blog/${post.id}`} class="relative block rounded-xl overflow-hidden group flex-1" style="min-height:190px;">
              {post.data.image && (
                <Image
                  class="w-full h-full object-cover group-hover:scale-[1.04] transition duration-500 absolute inset-0"
                  src={post.data.image}
                  alt={post.data.title}
                  width={460}
                  height={200}
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-4">
                <span class="inline-block bg-primary text-white text-xs font-bold px-2 py-0.5 rounded-full mb-2 uppercase tracking-wider">
                  {humanize(post.data.categories[0])}
                </span>
                <h4 class="text-white leading-snug line-clamp-2 drop-shadow text-sm">
                  {post.data.title}
                </h4>
                <span class="text-white/60 text-xs flex items-center gap-1 mt-1">
                  <BiCalendarEdit className="h-3 w-3" />
                  {dateFormat(post.data.date!)}
                </span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  )}

  {/* ── Divider with label ── */}
  {gridPosts.length > 0 && (
    <div class="flex items-center gap-4 mb-6">
      <span class="text-xs font-bold uppercase tracking-widest text-text-light">Latest Articles</span>
      <div class="flex-1 h-px bg-border"></div>
    </div>
  )}

  {/* ── Grid row: remaining posts ── */}
  {gridPosts.length > 0 && (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {gridPosts.map((post) => (
        <div class="group rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition duration-300 border border-border bg-white flex flex-col">
          {post.data.image && (
            <a href={`/blog/${post.id}`} class="block overflow-hidden" style="aspect-ratio:16/9;">
              <Image
                class="w-full h-full object-cover group-hover:scale-[1.04] transition duration-500"
                src={post.data.image}
                alt={post.data.title}
                width={400}
                height={225}
              />
            </a>
          )}
          <div class="p-4 flex flex-col flex-1">
            <span class="text-xs font-bold text-primary uppercase tracking-wider mb-2">
              {humanize(post.data.categories[0])}
            </span>
            <h4 class="leading-snug mb-2 flex-1">
              <a href={`/blog/${post.id}`} class="hover:text-primary transition duration-300 line-clamp-2">
                {post.data.title}
              </a>
            </h4>
            <p class="text-sm text-text line-clamp-2 mb-3">{plainify(post.body ?? "")}</p>
            <div class="flex items-center justify-between mt-auto pt-3 border-t border-border">
              <span class="text-xs text-text-light flex items-center gap-1">
                <BiCalendarEdit className="h-3 w-3" />
                {dateFormat(post.data.date!)}
              </span>
              <a href={`/blog/${post.id}`} class="text-xs font-semibold text-primary hover:underline">
                Read more →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}

</div>
